      "id": "07849baf-3901-4dd7-9b29-ff3979590469",
      "name": "Get On Order"
    },
    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst thirtyDaysOut = new Date();\nthirtyDaysOut.setDate(today.getDate() + 30);\n\nconst orders = $input.all()[0].json.value;\nconst aggregated = {};\n\nfor (const order of orders) {\n  // Skip rejected lines (only keep blank rejection reason)\n  if (order.SALESDOCUMENTRJCNREASON && order.SALESDOCUMENTRJCNREASON !== '') continue;\n\n  // Skip completed lines (Overall Delivery Status = C)\n  if (order.OVERALLDELIVERYSTATUS === 'C') continue;\n\n  const material = order.MATERIAL;\n  const openQty = (order.REQUESTEDQUANTITY || 0) - (order.CONFDDELIVQTYINORDERQTYUNIT || 0);\n  const delivDate = new Date(order.REQUESTEDDELIVERYDATE);\n\n  if (!aggregated[material]) {\n    aggregated[material] = { MATERIAL: material, TOTAL_OO: 0, OO_30D: 0 };\n  }\n\n  aggregated[material].TOTAL_OO += openQty;\n\n  if (delivDate <= thirtyDaysOut) {\n    aggregated[material].OO_30D += openQty;\n  }\n}\n\nreturn Object.values(aggregated).map(item => ({ json: item }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
