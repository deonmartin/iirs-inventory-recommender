    {
      "parameters": {
        "jsCode": "const items = $input.all()[0].json.value;\n\nconst pricingMap = {};\nitems.forEach(item => {\n  if (item.MATERIAL && item.CONDITIONRATEVALUE) {\n    pricingMap[item.MATERIAL] = {\n      material: item.MATERIAL,\n      netSellPrice: item.CONDITIONRATEVALUE,\n      currency: item.CONDITIONRATEVALUEUNIT\n    };\n  }\n});\n\nreturn Object.values(pricingMap).map(p => ({ json: p }));"
      },
