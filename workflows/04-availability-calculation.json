      "parameters": {
        "jsCode": "const stockData = $input.all()[0].json.value;\n\nreturn stockData.map(item => ({\n  json: {\n    MATERIAL: item.MATERIAL,\n    UOH: item.MATLWRHSSTKQTYINMATLBASEUNIT || 0\n  }\n}));"
      },
