      ],
      "id": "bbd4d377-cad0-4987-9a3d-9c35247eed6b",
      "name": "QOH unpack1"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json;\n  const uoh = data.UOH || 0;\n  const oo30d = data.OO_30D || 0;\n  const totalOO = data.TOTAL_OO || 0;\n  const inDelivery = data.IN_DELIVERY || 0;\n  const ats = Math.max(0, (uoh - oo30d) - inDelivery);\n\n  return {\n    json: {\n      MATERIAL: data.MATERIAL,\n      UOH: uoh,\n      IN_DELIVERY: inDelivery,\n      TOTAL_OO: totalOO,\n      OO_30D: oo30d,\n      ATS: ats\n    }\n  };\n});"
      },
