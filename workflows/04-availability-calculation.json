        "jsCode": "// Filter out \"0\" ATS\nconst allowedMGD2 = ['CATEGORY A US','CATEGORY A BR','CATEGORY B US','CATEGORY B BR','CATEGORY C US','CATEGORY C BR'];\nreturn $input.all()\n  .filter(item =>\n    allowedMGD2.includes((item.json.MGD2 || '').trim().toUpperCase()) &&\n    item.json.netSellPrice != null &&\n    item.json.netSellPrice !== 0 &&\n    item.json.ATS > 0\n  )\n  .map(item => ({ json: { ...item.json, FAMILY: (item.json.FAMILY || '').trim(), MGD2: (item.json.MGD2 || '').trim() } }));"
      },
